# Yahoo Developer app credentials (https://developer.yahoo.com/apps/)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional — point `npm run runs` at the deployed archive instead of data/
# HISTORY_BUCKET=muff-digest-history-<account-id>

# Fantasy data provider (MUFF-49). Default yahoo; sleeper needs no auth.
# FANTASY_PROVIDER=sleeper
# SLEEPER_LEAGUE_ID=1251080762300583936
# SLEEPER_USERNAME=your_sleeper_username

# Optional — pin a Yahoo league instead of auto-resolving the newest season.
# Also exposed by .mcp.json as ${YAHOO_LEAGUE_KEY:-} so a shell export wins.
# YAHOO_LEAGUE_KEY=461.l.12345
